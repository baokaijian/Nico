# Local development needs no credentials and binds only to 127.0.0.1.
NICO_HOST=127.0.0.1
PORT=3001
# Private maintenance remains on loopback; remote binding forces authenticated read-only access.
# Public display uses npm run serve:public or GitHub Pages with no private API.
NICO_AUTH_REQUIRED=false
NICO_READ_ONLY=false
NICO_OWNER_TOKEN=
NICO_COACH_TOKEN=
NICO_VIEWER_TOKEN=
NICO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Private production frontend: VITE_APP_MODE=private (not a token)
# NICO_WEB_DIR=/absolute/path/to/private/dist-private
# VITE_API_URL=https://your-private-service.example
# Public display process only (no private data or credentials)
NICO_PUBLIC_HOST=127.0.0.1
NICO_PUBLIC_PORT=8080
# NICO_PUBLIC_WEB_DIR=/absolute/path/to/public/dist
