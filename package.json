{
  "name": "nico",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/server.js",
    "serve:public": "node server/public-server.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predev": "node scripts/prepare-public.mjs",
    "prebuild": "node scripts/prepare-public.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run security:check && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:public",
    "security:check": "node scripts/check-repository-privacy.mjs",
    "security:history": "node scripts/check-repository-privacy.mjs --history",
    "security:hooks": "git config --local core.hooksPath .githooks",
    "verify:public": "node scripts/verify-public.mjs",
    "verify:guest": "node scripts/verify-guest-read.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:verify": "node scripts/verify-deployment.mjs",
    "release:consistency": "node scripts/verify-release-consistency.mjs",
    "backup:job": "node scripts/backup-job.mjs",
    "operations:run": "node scripts/reliability-runner.mjs",
    "storage:report": "node scripts/storage-report.mjs",
    "media:prepare": "node scripts/media-prepare.mjs",
    "init:data": "node scripts/init-data.mjs",
    "audit:data": "node scripts/prd-audit.mjs",
    "audit:performance": "node scripts/performance-migrate.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@pdf-lib/fontkit": "1.1.1",
    "express": "^5.2.1",
    "multer": "2.5.0",
    "pdf-lib": "1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "oxlint": "^1.69.0",
    "rolldown": "1.1.5",
    "typescript": "7.0.2",
    "vite": "8.1.6"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
